{
  "name": "@ranjeetk25/schema-grid-core",
  "version": "0.3.0",
  "description": "Schema-driven data grid core: schemas, field types, filters, formulas and the wire contract. Zero UI dependencies.",
  "license": "MIT",
  "author": "Masai School",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjeetk25/schema-grid.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/ranjeetk25/schema-grid/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/ranjeetk25/schema-grid/issues"
  },
  "keywords": [
    "data-grid",
    "schema",
    "spreadsheet",
    "airtable",
    "filter",
    "formula",
    "zod",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./field-types": {
      "development": "./src/field-types/index.ts",
      "types": "./dist/field-types/index.d.ts",
      "import": "./dist/field-types/index.js",
      "require": "./dist/field-types/index.cjs"
    },
    "./formula": {
      "development": "./src/formula/index.ts",
      "types": "./dist/formula/index.d.ts",
      "import": "./dist/formula/index.js",
      "require": "./dist/formula/index.cjs"
    },
    "./filter": {
      "development": "./src/filter/index.ts",
      "types": "./dist/filter/index.d.ts",
      "import": "./dist/filter/index.js",
      "require": "./dist/filter/index.cjs"
    },
    "./memory": {
      "development": "./src/memory/index.ts",
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./wire": {
      "development": "./src/wire/index.ts",
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "require": "./dist/wire/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^3.25 || ^4"
  },
  "devDependencies": {
    "zod": "^3.25.76"
  }
}
