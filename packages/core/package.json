{
  "name": "@masai/schema-grid-core",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./field-types": {
      "development": "./src/field-types/index.ts",
      "types": "./dist/field-types/index.d.ts",
      "import": "./dist/field-types/index.js",
      "require": "./dist/field-types/index.cjs"
    },
    "./formula": {
      "development": "./src/formula/index.ts",
      "types": "./dist/formula/index.d.ts",
      "import": "./dist/formula/index.js",
      "require": "./dist/formula/index.cjs"
    },
    "./filter": {
      "development": "./src/filter/index.ts",
      "types": "./dist/filter/index.d.ts",
      "import": "./dist/filter/index.js",
      "require": "./dist/filter/index.cjs"
    },
    "./memory": {
      "development": "./src/memory/index.ts",
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js",
      "require": "./dist/memory/index.cjs"
    },
    "./testing": {
      "development": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "require": "./dist/testing/index.cjs"
    },
    "./wire": {
      "development": "./src/wire/index.ts",
      "types": "./dist/wire/index.d.ts",
      "import": "./dist/wire/index.js",
      "require": "./dist/wire/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "zod": "^3.25 || ^4"
  },
  "devDependencies": {
    "zod": "^3.25.76"
  }
}
