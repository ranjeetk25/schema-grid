{
  "name": "@ranjeetk25/schema-grid-io",
  "version": "0.3.0",
  "description": "CSV/XLSX import, export and clipboard parsing for Schema Grid.",
  "license": "MIT",
  "author": "Masai School",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjeetk25/schema-grid.git",
    "directory": "packages/import-export"
  },
  "homepage": "https://github.com/ranjeetk25/schema-grid/tree/main/packages/import-export#readme",
  "bugs": {
    "url": "https://github.com/ranjeetk25/schema-grid/issues"
  },
  "keywords": [
    "data-grid",
    "csv",
    "xlsx",
    "excel",
    "import",
    "export",
    "clipboard",
    "schema-grid"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "browser": "./src/index.browser.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "browser": {
        "import": "./dist/index.browser.js",
        "require": "./dist/index.browser.cjs"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./import": {
      "development": "./src/import/index.ts",
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js",
      "require": "./dist/import/index.cjs"
    },
    "./export": {
      "development": {
        "browser": "./src/export/index.browser.ts",
        "default": "./src/export/index.ts"
      },
      "types": "./dist/export/index.d.ts",
      "browser": {
        "import": "./dist/export/index.browser.js",
        "require": "./dist/export/index.browser.cjs"
      },
      "import": "./dist/export/index.js",
      "require": "./dist/export/index.cjs"
    },
    "./clipboard": {
      "development": "./src/clipboard/index.ts",
      "types": "./dist/clipboard/index.d.ts",
      "import": "./dist/clipboard/index.js",
      "require": "./dist/clipboard/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "import": [
        "./dist/import/index.d.ts"
      ],
      "export": [
        "./dist/export/index.d.ts"
      ],
      "clipboard": [
        "./dist/clipboard/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ranjeetk25/schema-grid-core": "workspace:*",
    "papaparse": "^5.7.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15"
  },
  "browser": "./dist/index.browser.js"
}
