{
  "name": "@masai/schema-grid-io",
  "version": "0.0.1",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./import": {
      "development": "./src/import/index.ts",
      "types": "./dist/import/index.d.ts",
      "import": "./dist/import/index.js",
      "require": "./dist/import/index.cjs"
    },
    "./export": {
      "development": "./src/export/index.ts",
      "types": "./dist/export/index.d.ts",
      "import": "./dist/export/index.js",
      "require": "./dist/export/index.cjs"
    },
    "./clipboard": {
      "development": "./src/clipboard/index.ts",
      "types": "./dist/clipboard/index.d.ts",
      "import": "./dist/clipboard/index.js",
      "require": "./dist/clipboard/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "import": ["./dist/import/index.d.ts"],
      "export": ["./dist/export/index.d.ts"],
      "clipboard": ["./dist/clipboard/index.d.ts"]
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@masai/schema-grid-core": "workspace:*",
    "papaparse": "^5.7.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.15"
  }
}
