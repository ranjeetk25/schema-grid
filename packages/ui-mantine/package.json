{
  "name": "@ranjeetk25/schema-grid-ui-mantine",
  "version": "0.3.1",
  "description": "Mantine v8 UI for Schema Grid: cell editors, filter and column builders, import wizard and export dialog.",
  "license": "MIT",
  "author": "Masai School",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjeetk25/schema-grid.git",
    "directory": "packages/ui-mantine"
  },
  "homepage": "https://github.com/ranjeetk25/schema-grid/tree/main/packages/ui-mantine#readme",
  "bugs": {
    "url": "https://github.com/ranjeetk25/schema-grid/issues"
  },
  "keywords": [
    "mantine",
    "react",
    "data-grid",
    "ag-grid",
    "filter-builder",
    "column-builder",
    "schema-grid"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editors": {
      "development": "./src/editors/index.ts",
      "types": "./dist/editors/index.d.ts",
      "import": "./dist/editors/index.js",
      "require": "./dist/editors/index.cjs"
    },
    "./filter-builder": {
      "development": "./src/filter-builder/index.ts",
      "types": "./dist/filter-builder/index.d.ts",
      "import": "./dist/filter-builder/index.js",
      "require": "./dist/filter-builder/index.cjs"
    },
    "./column-builder": {
      "development": "./src/column-builder/index.ts",
      "types": "./dist/column-builder/index.d.ts",
      "import": "./dist/column-builder/index.js",
      "require": "./dist/column-builder/index.cjs"
    },
    "./import-export": {
      "development": "./src/import-export/index.ts",
      "types": "./dist/import-export/index.d.ts",
      "import": "./dist/import-export/index.js",
      "require": "./dist/import-export/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ranjeetk25/schema-grid-ag-grid": "workspace:*",
    "@ranjeetk25/schema-grid-core": "workspace:*",
    "@ranjeetk25/schema-grid-io": "workspace:*",
    "@tabler/icons-react": "^3.48.0"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "@mantine/core": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/dates": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "dayjs": "^1.11.0",
    "zod": "^3.25 || ^4"
  },
  "peerDependenciesMeta": {
    "@mantine/notifications": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mantine/core": "^8.3.18",
    "@mantine/dates": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@mantine/notifications": "^8.3.18",
    "@testing-library/user-event": "^14.6.1",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "dayjs": "^1.11.23",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.25.76"
  }
}
