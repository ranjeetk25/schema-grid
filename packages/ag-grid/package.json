{
  "name": "@ranjeetk25/schema-grid-ag-grid",
  "version": "0.2.0",
  "description": "AG Grid Community binding for Schema Grid: column compiler, editors, range selection, clipboard and fill handle.",
  "license": "MIT",
  "author": "Masai School",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjeetk25/schema-grid.git",
    "directory": "packages/ag-grid"
  },
  "homepage": "https://github.com/ranjeetk25/schema-grid/tree/main/packages/ag-grid#readme",
  "bugs": {
    "url": "https://github.com/ranjeetk25/schema-grid/issues"
  },
  "keywords": [
    "ag-grid",
    "data-grid",
    "react",
    "spreadsheet",
    "range-selection",
    "clipboard",
    "schema-grid"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./editors": {
      "development": "./src/editors/index.ts",
      "types": "./dist/editors/index.d.ts",
      "import": "./dist/editors/index.js",
      "require": "./dist/editors/index.cjs"
    },
    "./filters": {
      "development": "./src/filters/index.ts",
      "types": "./dist/filters/index.d.ts",
      "import": "./dist/filters/index.js",
      "require": "./dist/filters/index.cjs"
    },
    "./sync": {
      "development": "./src/sync/index.ts",
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.js",
      "require": "./dist/sync/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ranjeetk25/schema-grid-core": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ag-grid-community": "^36.0.0",
    "ag-grid-react": "^36.0.0",
    "@ranjeetk25/schema-grid-io": "*"
  },
  "peerDependenciesMeta": {
    "@ranjeetk25/schema-grid-io": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ag-grid-community": "^36.2.0",
    "ag-grid-react": "^36.2.0",
    "@ranjeetk25/schema-grid-io": "workspace:*"
  }
}
