{
  "name": "@ranjeetk25/schema-grid-server",
  "version": "0.0.1",
  "description": "Server side of Schema Grid: permission-checked Drizzle/MySQL queries, change feed, import/export jobs and HTTP adapters.",
  "license": "MIT",
  "author": "Masai School",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjeetk25/schema-grid.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/ranjeetk25/schema-grid/tree/main/packages/server#readme",
  "bugs": {
    "url": "https://github.com/ranjeetk25/schema-grid/issues"
  },
  "keywords": [
    "data-grid",
    "drizzle",
    "mysql",
    "server",
    "permissions",
    "express",
    "hono",
    "schema-grid"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./drizzle": {
      "development": "./src/drizzle/index.ts",
      "types": "./dist/drizzle/index.d.ts",
      "import": "./dist/drizzle/index.js",
      "require": "./dist/drizzle/index.cjs"
    },
    "./ddl": {
      "development": "./src/ddl/index.ts",
      "types": "./dist/ddl/index.d.ts",
      "import": "./dist/ddl/index.js",
      "require": "./dist/ddl/index.cjs"
    },
    "./http": {
      "development": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js",
      "require": "./dist/http/index.cjs"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "SCHEMA_GRID_MYSQL_IT=1 vitest run test/integration"
  },
  "dependencies": {
    "@ranjeetk25/schema-grid-core": "workspace:*"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.0",
    "mysql2": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "mysql2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testcontainers/mysql": "^12.1.0",
    "drizzle-orm": "^0.45.3",
    "mysql2": "^3.24.4",
    "zod": "^3.25.76"
  }
}
